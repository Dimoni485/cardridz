# Скопируйте в /opt/cardridz/.env и замените значения.
# Файл содержит секреты: chmod 600.

POSTGRES_DB=cardridz
POSTGRES_USER=cardridz
POSTGRES_PASSWORD=change-me-strong-password

JWT_SECRET=change-me-64-hex-characters
ACCESS_TOKEN_EXPIRE_MINUTES=720

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_FULL_NAME=Администратор

# Демо-данные создаются только при пустой базе. Для реальной эксплуатации: false
SEED_DEMO=true

APP_PORT=8081
TZ=Europe/Moscow
CORS_ORIGINS=[]
